{
  // markdownlint-cli2 file selection (globs + ignores). Lint *rules* live in
  // .markdownlint.jsonc. Used by CI/manual runs (`npx markdownlint-cli2`).
  // The PostToolUse format hook passes an explicit file path, so it is
  // unaffected by these globs (it only ever edits source docs, never the
  // ignored dirs below).
  "globs": ["**/*.md"],
  "gitignore": true,
  "ignores": [
    "node_modules/**",
    ".venv/**",
    ".claude/skills/**", // vendored holoviz-skills docs, not ours to reformat
    ".claude/worktrees/**", // nested git worktree checkouts, not source of truth here
    "docs/site/**", // mkdocs build output
    "docs/.cache/**", // mkdocs-material cache
    "docs/superpowers/**"
  ]
}
